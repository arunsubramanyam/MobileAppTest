{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "appium-mcp": {
      "enabled": true,
      "timeout": 15000,
      "type": "local",
      "command": ["npx", "-y", "appium-mcp"],
      "environment": {
        "ANDROID_HOME": "${ANDROID_HOME}",
        "CAPABILITIES_CONFIG": "./capabilities.json"
      }
    },
    "dart-mcp-server": {
      "type": "local",
      "command": [
        "C:/tools/dart-sdk/dart-sdk/bin/dart",
        "mcp-server"
      ],
      "enabled": true,
      "environment": {}
    },
    "stitch": {
      "type": "local",
      "command": ["npx", "@_davideast/stitch-mcp", "proxy"],
      "enabled": true,
      "environment": {
        "STITCH_API_KEY": "AQ.Ab8RN6JFlCsKyMm_6rCEh2Gm6bQT4PbOekrMqdUZZUt-V4Lkmw"
      }
    },
    "wdio-mcp": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "--package=@wdio/mcp", "wdio-mcp"]
    }
  }
}